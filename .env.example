# Copy to .env and fill in. .env is gitignored — never commit it.
#
#   cp .env.example .env
#   openssl rand -hex 32   # generate API_TOKEN

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Bearer token required by every endpoint except /api/v1/health.
API_TOKEN=replace-me-with-a-long-random-token

# ---------------------------------------------------------------------------
# Host paths (OMV) — used by compose.yaml to build the bind mounts.
# Replace <DISK-UUID> with your actual OMV data disk, e.g.
#   ls -d /srv/dev-disk-by-uuid-*/compose/data/obsidian-vault
# INBOX_HOST_PATH must point at 00_Inbox/ChatGPT *inside* the vault.
# ---------------------------------------------------------------------------
VAULT_HOST_PATH=/srv/dev-disk-by-uuid-<DISK-UUID>/compose/data/obsidian-vault
INBOX_HOST_PATH=/srv/dev-disk-by-uuid-<DISK-UUID>/compose/data/obsidian-vault/00_Inbox/ChatGPT

# ---------------------------------------------------------------------------
# Container-internal paths — normally leave these alone.
# VAULT_INBOX_RELATIVE_PATH is where INBOX_HOST_PATH sits relative to the vault
# root. The API needs it to report vault-relative paths for created notes,
# because read and write are two separate mounts inside the container.
# ---------------------------------------------------------------------------
VAULT_READ_ROOT=/vault-ro
VAULT_INBOX_ROOT=/vault-write/inbox
VAULT_INBOX_RELATIVE_PATH=00_Inbox/ChatGPT

# ---------------------------------------------------------------------------
# Limits (docs/IMPLEMENTATION_PLAN.md section 17)
# ---------------------------------------------------------------------------
MAX_SEARCH_RESULTS=50
MAX_NOTE_SIZE_BYTES=1048576
MAX_REQUEST_BYTES=2097152

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
TZ=Asia/Tokyo
LOG_LEVEL=INFO
