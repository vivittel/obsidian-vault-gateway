# Copy to .env and fill in. .env is gitignored — never commit it.
#
#   cp .env.example .env
#   openssl rand -hex 32   # generate API_TOKEN

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Bearer token required by every endpoint except /api/v1/health.
API_TOKEN=replace-me-with-a-long-random-token

# ---------------------------------------------------------------------------
# MCP Streamable HTTP transport (/mcp)
# ---------------------------------------------------------------------------
# Comma-separated Host header values /mcp accepts (DNS-rebinding allowlist).
# Required: the MCP SDK auto-restricts this to localhost when unset, which
# silently rejects every request that arrives through Caddy with a real Host
# header. Set this to the hostname(s) Caddy forwards, e.g. the value below.
MCP_ALLOWED_HOSTS=obsidian-api.example.com

# ---------------------------------------------------------------------------
# Docker network (compose.yaml)
# ---------------------------------------------------------------------------
# Name of the external Docker network Caddy is already on. compose.yaml's
# local alias for this is always "proxy"; PROXY_NETWORK is only the real
# name to attach to. Defaults to "caddy" — the network this compose file has
# actually used; set it if your OMV host calls it something else (e.g. br0).
PROXY_NETWORK=caddy

# ---------------------------------------------------------------------------
# Container image (compose.yaml)
# ---------------------------------------------------------------------------
# GHCR image compose.yaml pulls. Defaults to :latest (published by
# .github/workflows/publish.yml on every main push). Override to pin a
# specific commit SHA tag — see README's "Rolling back" section.
OBSIDIAN_GATEWAY_IMAGE=ghcr.io/vivittel/obsidian-vault-gateway:latest

# ---------------------------------------------------------------------------
# Host paths (OMV) — used by compose.yaml to build the bind mounts.
# Replace <DISK-UUID> with your actual OMV data disk, e.g.
#   ls -d /srv/dev-disk-by-uuid-*/compose/data/obsidian-vault
# INBOX_HOST_PATH must point at 00_Inbox/ChatGPT *inside* the vault.
# ---------------------------------------------------------------------------
VAULT_HOST_PATH=/srv/dev-disk-by-uuid-<DISK-UUID>/compose/data/obsidian-vault
INBOX_HOST_PATH=/srv/dev-disk-by-uuid-<DISK-UUID>/compose/data/obsidian-vault/00_Inbox/ChatGPT

# ---------------------------------------------------------------------------
# Container-internal paths — normally leave these alone.
# VAULT_INBOX_RELATIVE_PATH is where INBOX_HOST_PATH sits relative to the vault
# root. The API needs it to report vault-relative paths for created notes,
# because read and write are two separate mounts inside the container.
# ---------------------------------------------------------------------------
VAULT_READ_ROOT=/vault-ro
VAULT_INBOX_ROOT=/vault-write/inbox
VAULT_INBOX_RELATIVE_PATH=00_Inbox/ChatGPT

# ---------------------------------------------------------------------------
# Limits (docs/IMPLEMENTATION_PLAN.md section 17)
# ---------------------------------------------------------------------------
MAX_SEARCH_RESULTS=50
MAX_NOTE_SIZE_BYTES=1048576
MAX_REQUEST_BYTES=2097152

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# TZ also sets the timezone of the timestamp on every log line.
TZ=Asia/Tokyo

# Applied to the obsidian_gateway loggers by app/logging_config.py. DEBUG
# additionally surfaces the /api/v1/health access-log line, which is
# deliberately below INFO because the Docker HEALTHCHECK hits that route every
# 30 seconds. See README's Logging section for the line format.
LOG_LEVEL=INFO
